# Copy to .env and fill in. Loaded by backup.sh, the scenarios and the demo server.

# Vercel AI Gateway key. The Vercel team that owns the key must have a card on file,
# otherwise every request fails with 403 customer_verification_required.
AI_GATEWAY_API_KEY=

# Port of the demo UI (optional)
DEMO_PORT=8600

# Host user for the Docker backends, so repos/ stays owned by you (setup.sh fills these in)
LAB_UID=1000
LAB_GID=1000
